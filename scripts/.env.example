# Path to your Xbox GDK game directory (used by run-game, precompile-shaders, and smoke.ps1)
GAME_PATH=C:\Games\YourGameFolder

# Path to modern DXC bin\x64 folder (containing dxcompiler.dll and dxil.dll v1.8+)
# Download from: https://github.com/microsoft/DirectXShaderCompiler/releases
# XCL_DXC_DIR=C:\tools\dxc\bin\x64

# Worker threads for shader compilation (set to your CPU logical processors, or omit for auto-detect)
# XCL_DXC_THREADS=20

# Memory reserve threshold (GB) before throttling workers. Set to 0 to uncap all CPU threads.
XCL_MEMORY_RESERVE_GB=0

# Timeout (seconds) for memory wait. Set to 0 for instant allocation.
XCL_MEMORY_WAIT_SECS=0

# --- Test & Smoke settings ---
# Duration in seconds for smoke test run (default: 60)
SMOKE_SECONDS=60

# Parallel test threads for test.ps1 (default: 4 per CONTRIBUTING.md to prevent GPU out-of-memory)
TEST_THREADS=4
